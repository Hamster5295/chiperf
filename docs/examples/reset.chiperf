chiperf 2.0
@domain default, period=1.0ns
@meta design="rst-demo", tool="handwritten", note="演示 [rst]：复位前的记录整批作废"

# ---- 复位之前：这些记录都不会进入可视化 ----
[clk] p
[cnt] "retired"
[val] "core.pc", 0x1000
[pip] "core.if", 0x1000
[clk] n
[clk] p
[cnt] "retired"
[clk] n

[rst]                                   # 系统复位：此前全部事件记录作废

# ---- 复位之后：窗口从这里开始 ----
[clk] p
[cnt] "retired"                         # 累计从这里重新开始（= 1，不是 3）
[val] "core.pc", 0x8000
[clk] n
@end
